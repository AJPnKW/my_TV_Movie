{
  "_meta": {
    "file": "web/config.json",
    "version": "v1.4.1",
    "updated_utc": "2026-01-27T00:00:00Z",
    "notes": [
      "Authoritative config for streaming base URLs, image cache folders, and UI tuning.",
      "JSON cannot contain comments. All documentation is embedded in _meta and ui_palette.docs.",
      "Palette system is a registry (multiple palettes). Pages apply ui_palette.palettes[ui_palette.active].tokens as CSS variables, then alias legacy variables so existing CSS selectors keep working without refactors.",
      "Night is default; Day is provided for bright-room viewing and has stronger surface separation to avoid 'washed out' appearance on TVs."
    ]
  },

  "streaming": {
    "vidsrc_tv": "https://vidsrc.net/embed/tv/",
    "vidsrc_movie": "https://vidsrc.net/embed/movie/",
    "videasy_tv": "https://player.videasy.net/tv/",
    "videasy_movie": "https://player.videasy.net/movie/"
  },

  "image_sizes": {
    "show_width": 150,
    "movie_width": 150,
    "season_width": 1100,
    "episode_still_w": 75,
    "calendar_thumb_w": 80,
    "hero_poster_w": 230,
    "hero_poster_min": 180,
    "episode_card_w": 320,
    "network_logo_max_w": 15,
    "provider_logo_max_w": 15,
    "backdrop_w": 780
  },

  "ui_palette": {
    "active": "night_tv",

    "docs": {
      "intent": "TV-first palette system with high legibility + obvious focus states. Apply tokens first, then alias legacy vars.",
      "application_order": [
        "1) Apply tokens: for each key in tokens, set CSS var --<key> to its value (example: --c-bg-1).",
        "2) Apply derived: set CSS var --<key> to derived string values (example: --g-bg, --g-card, --ring-focus).",
        "3) Apply legacy aliases: set CSS vars like --bg/--panel/--text to var(--token_key) so existing CSS keeps working."
      ],
      "focus_rules": [
        "Focusable controls must show a TV-visible focus ring using --ring-focus on :focus-visible.",
        "Selected states must use 3 cues: border stronger, tinted fill, subtle glow (chips and list rows)."
      ],
      "component_token_map": [
        { "component": "Page background", "use": ["--g-bg", "--c-bg-1"] },
        { "component": "Card/panel", "use": ["--c-surface-1", "--g-card", "--c-border"] },
        { "component": "Elevated bar/sticky header", "use": ["--c-surface-2", "--c-border"] },
        { "component": "Primary text", "use": ["--c-text"] },
        { "component": "Secondary text", "use": ["--c-text-muted"] },
        { "component": "Tertiary text/hints", "use": ["--c-text-dim"] },
        { "component": "Borders", "use": ["--c-border"], "selected": ["--c-border-strong"] },
        { "component": "Default button", "use": ["--c-surface-2", "--c-text", "--c-border"], "hover": ["--c-surface-3"] },
        { "component": "Primary button/tab", "use": ["--c-accent"], "text": ["#06101A"] },
        { "component": "Chips/pills/tags", "use": ["--c-border", "rgba(255,255,255,0.06)", "--c-text-muted"], "selected": ["--c-border-strong", "accent tint + glow"] },
        { "component": "Inputs/select/textarea", "use": ["--c-surface-1", "--c-text", "--c-border"], "focus": ["--ring-focus"] },
        { "component": "Checkbox/radio", "use": ["accent-color: var(--c-accent)"] },
        { "component": "Toggle switch", "use": ["track: --c-border", "thumb: #fff (night) / #0B1324 (day)"], "on": ["status colors"] },
        { "component": "Slider range", "use": ["track: --c-border", "fill: --c-accent", "thumb: #fff/#0B1324"], "focus": ["--ring-focus"] },
        { "component": "Progress bar", "use": ["--g-progress"] },
        { "component": "Modal", "use": ["--c-surface-2", "--c-border"], "focus": ["--ring-focus"] },
        { "component": "Banners/toasts", "use": ["--c-surface-2", "--c-border"], "status": ["--c-warning/--c-danger/--c-success"] }
      ]
    },

    "alias_to_legacy_vars": {
      "bg": "c-bg-1",
      "panel": "c-surface-1",
      "panel2": "c-surface-2",
      "text": "c-text",
      "muted": "c-text-muted",
      "line": "c-border",
      "accent": "c-accent",
      "good": "c-success",
      "bad": "c-danger"
    },

    "optional_legacy_vars": {
      "chip": "rgba(255,255,255,0.06)",
      "chip2": "rgba(255,255,255,0.10)"
    },

    "palettes": {
      "night_tv": {
        "name": "Night TV Premium",
        "tokens": {
          "c-bg-0": "#070A10",
          "c-bg-1": "#0A0F18",
          "c-surface-1": "#0E1624",
          "c-surface-2": "#121D2F",
          "c-surface-3": "#172640",

          "c-text": "#EAF1FF",
          "c-text-muted": "#B7C6E3",
          "c-text-dim": "#8EA1C6",

          "c-border": "rgba(255,255,255,0.12)",
          "c-border-strong": "rgba(255,255,255,0.22)",

          "c-accent": "#4C8DFF",
          "c-accent-2": "#25D0C6",

          "c-info": "#6AB6FF",
          "c-success": "#2FE08A",
          "c-warning": "#FFD166",
          "c-danger": "#FF5C72",
          "c-brand-magenta": "#F06BE5",

          "c-focus-outer": "#FFFFFF",
          "c-focus-inner": "#4C8DFF",

          "c-shadow": "rgba(0,0,0,0.55)"
        },
        "derived": {
          "g-bg": "radial-gradient(1200px 800px at 18% -10%, rgba(76,141,255,0.18), transparent 55%), radial-gradient(900px 700px at 112% 8%, rgba(37,208,198,0.14), transparent 60%), var(--c-bg-1)",
          "g-card": "linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02))",
          "g-progress": "linear-gradient(90deg, rgba(76,141,255,0.95), rgba(47,224,138,0.95))",
          "ring-focus": "0 0 0 2px var(--c-focus-inner), 0 0 0 4px rgba(255,255,255,0.90)"
        }
      },

      "day_tv": {
