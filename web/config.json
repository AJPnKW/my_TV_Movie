          "c-brand-magenta": "#E056C9",

          "c-focus-outer": "#000000",
          "c-focus-inner": "#4C8DFF",

          "c-shadow": "rgba(0,0,0,0.18)"
        },
        "derived": {
          "g-bg": "radial-gradient(1200px 800px at 18% -10%, rgba(76,141,255,0.10), transparent 62%), radial-gradient(900px 700px at 112% 8%, rgba(37,208,198,0.08), transparent 64%), var(--c-bg-1)",
          "g-card": "linear-gradient(180deg, rgba(255,255,255,0.92), rgba(255,255,255,0.78))",
          "g-progress": "linear-gradient(90deg, rgba(76,141,255,0.92), rgba(31,191,117,0.92))",
          "ring-focus": "0 0 0 2px var(--c-focus-inner), 0 0 0 4px rgba(0,0,0,0.65)"
        }
      }
    }
  },

