  "ui_palette": {
    "active": "night_tv",

    "docs": {
      "intent": "TV-first palette registry. Tokens define meaning (not components). Components map to tokens for consistent UI across pages.",
      "application_order": [
        "1) Apply tokens: set CSS var --<tokenKey> to token value (example: --c-bg-1).",
        "2) Apply derived: set CSS var --<derivedKey> (example: --g-bg, --g-card, --ring-focus).",
        "3) Apply legacy aliases: set --bg/--panel/etc to var(--tokenKey) so existing CSS keeps working."
      ],
      "component_token_map": [
        { "component": "Page background", "use": ["--g-bg", "--c-bg-1"] },
        { "component": "Panels/cards", "use": ["--c-surface-1", "--g-card", "--c-border"] },
        { "component": "Elevated bars/sticky headers", "use": ["--c-surface-2", "--c-border"] },
        { "component": "Hover/active surface", "use": ["--c-surface-3"] },

        { "component": "Primary text", "use": ["--c-text"] },
        { "component": "Secondary text", "use": ["--c-text-muted"] },
        { "component": "Tertiary text/hints", "use": ["--c-text-dim"] },

        { "component": "Borders", "use": ["--c-border"], "selected": ["--c-border-strong"] },
        { "component": "Dividers/separators", "use": ["--c-divider"] },

        { "component": "Buttons (default)", "use": ["--c-surface-2", "--c-text", "--c-border"], "hover": ["--c-surface-3"], "focus": ["--ring-focus"] },
        { "component": "Buttons/tabs (primary)", "use": ["--c-accent"], "text": ["#06101A"] },
        { "component": "Danger actions", "use": ["--c-danger"], "mix_with": ["--c-surface-2"] },

        { "component": "Chips/tags", "use": ["--c-chip-bg", "--c-border", "--c-text-muted"], "selected": ["--c-chip-selected-bg", "--c-border-strong", "--c-chip-selected-glow"] },

        { "component": "Inputs/select/textarea", "use": ["--c-field-bg", "--c-text", "--c-border"], "focus": ["--ring-focus"] },
        { "component": "Readonly fields", "use": ["--c-field-bg-alt", "--c-text", "--c-border"] },
        { "component": "Disabled fields", "use": ["--c-disabled-bg", "--c-disabled-text", "--c-border"] },

        { "component": "Checkbox/radio", "use": ["accent-color: var(--c-accent)"] },

        { "component": "Toggle switch", "use": ["track: --c-toggle-track", "thumb: --c-toggle-thumb"], "on": ["--c-success (or status colors)"] },

        { "component": "Slider (range)", "use": ["--c-slider-track", "--c-slider-fill", "--c-slider-thumb"], "focus": ["--ring-focus"] },

        { "component": "Progress bars", "use": ["--g-progress"] },

        { "component": "Modal", "surface": ["--c-surface-2"], "overlay": ["--c-overlay"], "focus": ["--ring-focus"] }
      ],
      "selection_rule": [
        "Selection must be obvious at TV distance: (1) border stronger, (2) tinted fill, (3) subtle glow."
      ]
    },

    "alias_to_legacy_vars": {
      "bg": "c-bg-1",
      "panel": "c-surface-1",
      "panel2": "c-surface-2",
      "text": "c-text",
      "muted": "c-text-muted",
      "line": "c-border",
      "accent": "c-accent",
      "good": "c-success",
      "bad": "c-danger"
    },

    "palettes": {
