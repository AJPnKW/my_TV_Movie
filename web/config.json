          "c-bg-1": "#EEF2F7",
          "c-surface-1": "#FFFFFF",
          "c-surface-2": "#E1E7F0",
          "c-surface-3": "#D0D9E8",

          "c-text": "#0B1324",
          "c-text-muted": "#3F4F6B",
          "c-text-dim": "#5B6B86",

          "c-border": "rgba(0,0,0,0.16)",
          "c-border-strong": "rgba(0,0,0,0.26)",

          "c-accent": "#4C8DFF",
