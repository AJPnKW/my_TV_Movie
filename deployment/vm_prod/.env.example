# my_TV_Movie HP media VM example environment.
# Copy this file to /opt/mytv_movie/.env only on the VM when local values are needed.
# Do not commit .env or real secrets.

MYTV_ENV=production
MYTV_REPO_ROOT=/opt/mytv_movie
MYTV_WEB_HOST=0.0.0.0
MYTV_WEB_PORT=80
MYTV_API_HOST=127.0.0.1
MYTV_API_PORT=8000
MYTV_API_BASE_PATH=/api/v1
MYTV_POSTGRES_DSN=postgresql:///mytv_movie?host=/var/run/postgresql

POSTGRES_HOST=/var/run/postgresql
POSTGRES_PORT=5432
POSTGRES_DB=mytv_movie
POSTGRES_USER=mytv_movie

TRAKT_CLIENT_ID=replace_with_local_value
TRAKT_CLIENT_SECRET=replace_with_local_secret
